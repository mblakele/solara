# VUE / EM1 metrics credentials (required for NBC predictions)
VUE_USERNAME=your_vue_username
VUE_PASSWORD=your_vue_password

# === Load Management Configuration ===

# Enable/disable automatic load management background loop. Accepts True,
# False, or a time range in HH:MM-HH:MM 24-hour format (e.g., "06:45-15:00").
# When a time range is given, load management is active only during that window
# (inclusive start, exclusive end) in the device timezone.
LOAD_MANAGE_ENABLED=False

# Interval in seconds between automatic load management cycles
LOAD_MANAGE_INTERVAL_SECS=30

# Dry-run mode: actions are calculated and logged but NOT executed.
# Use this to verify configuration before enabling real control.
LOAD_MANAGE_DRY_RUN=False

# Lumpy-first residual turn_off: decide >=1000 W loads first when one of them
# dominates the trailing rate, then budget small plugs on the residual.
# Default off (status-quo binpack); enable to observe in dry-run first.
LOAD_MANAGE_LUMPY_FIRST=False
LOAD_MANAGER_RAMP_AWARE=False

# Observation windows the Tesla stop's safe defer deadline must still clear
# before a defer is taken (shipped 1). A deferral whose deadline sits inside
# the next window cannot be observed through, so the stop is taken now. The
# window is the resolved prediction/settle window, never a literal 30 s.
# 0 restores the pre-2026-10-19 static rule.
LOAD_MANAGER_DEFER_LOOKAHEAD_QUANTA=1

# Plug controller type: "real" (aiohomekit) or "stub" (in-memory mock)
# When both HomeKit and VOCOlinc plugs are configured, a composite controller
# is used automatically. This setting controls the HomeKit backend type.
LOAD_PLUG_CONTROLLER=stub

# === Device Configuration ===
# Device-specific settings (timezone, smart meter, plugs, Tesla vehicle) are
# now managed in devices.json. Copy devices.json.example to devices.json and
# edit it for your setup. That file is git-ignored and never committed.

# === VOCOlinc Credentials ===
# Required if using VOCOlinc plugs (credentials stay in .env as secrets)
VOCOLINC_USERNAME=
VOCOLINC_PASSWORD=

# Tesla controller type: "real" (tesla-fleet-api) or "stub" (in-memory mock)
LOAD_TESLA_CONTROLLER=stub

# === Tesla Fleet API Configuration (required for real Tesla controller) ===
# Get these from https://developer.tesla.com/
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na

# Comma-separated Tesla account emails allowed to authenticate. The OAuth
# callback rejects any other account. Leave empty to reject all attempts.
TESLA_OWNER_EMAILS=

# Tesla vehicle identifier and home GPS coordinates. These are treated as
# private data — store them in .env rather than in devices.json.
TESLA_VEHICLE_ID=
TESLA_HOME_LAT=
TESLA_HOME_LON=

# Path to Tesla Fleet API private key file (PEM format). Required for
# vehicle commands like set_amps. Without this, auth works but commands fail.
TESLA_PRIVATE_KEY_PATH=

# Nominal mains voltage (V) used for all Tesla amp<->watt conversions.
# Defaults to 240; set to 208 or 230 for other services.
# TESLA_NOMINAL_VOLTAGE=240

# === Logging Configuration ===
# Log file path. Leave unset or empty to log to stdout only.
# LOG_FILE=solara.log

# Max size in bytes before log rotation (default: 10485760 = 10 MB)
# LOG_MAX_BYTES=10485760

# Number of rotated log files to keep (default: 5)
# LOG_BACKUP_COUNT=5

# === Fleet Telemetry (MQTT via self-hosted fleet-telemetry container) ===
# Host/IP of the Mosquitto MQTT broker (co-located with fleet-telemetry).
MQTT_HOST=localhost
# Port for the Mosquitto broker (default 1883, unauthenticated).
MQTT_PORT=1883
# Base topic prefix used by the fleet-telemetry container.
MQTT_TOPIC_BASE=telemetry
# Path to the CA certificate used to provision the fleet-telemetry server.
TESLA_TELEMETRY_CA_FILE=
# Publish interval overrides (seconds).
TESLA_TELEMETRY_CHARGESTATE_INTERVAL_SEC=15
TESLA_TELEMETRY_LOCATION_INTERVAL_SEC=120
TESLA_TELEMETRY_CHARGEAMPS_INTERVAL_SEC=15
TESLA_TELEMETRY_DETAILEDCHARGESTATE_INTERVAL_SEC=15

# === OIDC Authentication (writes) ===
# Reads are anonymous. Writes require an OIDC login whose (iss, sub) pair
# is on the allowlist. Leave OIDC_ISSUER unset to disable the login flow
# (writes then fail closed); see docs/AUTH.md.
# Public base URL of this app (drives the OIDC redirect URI and the
# session-cookie Secure flag). Register <PUBLIC_URL>/oidc/callback with
# the provider.
PUBLIC_URL=http://localhost:8000
# Flask session secret. Generate with `python -c "import secrets;
# print(secrets.token_urlsafe(48))"` and never commit it.
FLASK_SECRET_KEY=
# OIDC issuer URL (e.g. https://accounts.google.com,
# https://authentik.example.com/application/o/solara/,
# https://keycloak.example.com/realms/solara). Discovery runs against
# <OIDC_ISSUER>/.well-known/openid-configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Write allowlist: comma-separated "iss|sub" pairs, e.g.
# "https://accounts.google.com|123456789". Never matches on email.
# Empty means nobody can write (fail closed); the /oidc/callback log
# lines iss/sub on login, so copy them here to bootstrap.
OIDC_ALLOWED_SUB=
# Session cookie Secure override. Leave unset: it follows PUBLIC_URL
# (on for https, off for local http). Set True/False explicitly only
# when the proxy chain needs it.
# SESSION_COOKIE_SECURE=
# Number of reverse-proxy hops to trust for X-Forwarded-For/Proto/Host.
# 0 (default) disables proxy header handling; set to the real hop count
# when serving behind a proxy so the OIDC redirect URI uses https.
# PROXY_TRUSTED_HOPS=1
